# Konfigurasi lokal/deployment
# .env tidak lagi dipakai. Semua konfigurasi pindah ke application/config/.
# Aturan di bawah tetap dipertahankan agar berkas .env tidak pernah ikut
# ter-commit bila suatu saat ada yang memakainya lagi.
.env
.env.*
!.env.example

# Konfigurasi per-environment yang berisi kredensial server. CodeIgniter
# menggabungkannya otomatis, dan isinya tidak boleh masuk repository.
/application/config/production/

# Session, cache, dan log CodeIgniter
application/cache/*
!application/cache/index.html
application/logs/*
application/config/database.php
application/config/development/database.php
!application/logs/index.html

# Log server lokal
*.log

# Skrip debug, probe, dan utilitas password. Hanya untuk mesin lokal.
# fix_password.php pernah bisa mengubah password admin tanpa autentikasi,
# jadi tidak boleh pernah ikut ter-commit maupun ter-upload.
/fix_password.php
/test_*.php
/diagnosa.php

# File sementara dan hasil pengujian
tmp/
database/_test_*.sql

# Editor dan sistem operasi
.idea/
.vscode/
.DS_Store
Thumbs.db

# Dependencies hasil instalasi
vendor/

# Cache hasil kompilasi stylesheet
.sass-cache/
