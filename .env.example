# =============================================================================
#  Salinan .env  —  JANGAN pernah diisi dengan kredensial asli.
#
#  File ini ikut ter-commit ke repository, jadi isinya akan terlihat oleh
#  siapa pun yang punya akses repo. Yang diizinkan di sini hanya placeholder.
#  Kredensial asli hanya boleh ada di .env, yang tidak pernah di-commit.
#
#  Salin file ini menjadi .env di server, lalu ganti setiap placeholder.
# =============================================================================

# Application Environment: development | testing | production
# WAJIB production di server. Nilai development akan menyalakan display_errors,
# dan warning yang tercetak sebelum redirect membuat cookie session hilang
# sehingga login selalu kembali ke halaman login.
CI_ENV=production

# Base URL aplikasi.
#
# BIARKAN KOSONG bila aplikasi tidak berada di belakang reverse proxy.
# base_url akan disusun otomatis dari HTTP_HOST dan lokasi index.php, jadi
# aplikasi tetap benar saat foldernya dipindah, misalnya /ipak_skm/.
#
# Isi HANYA bila host publik berbeda dari host yang diterima PHP, dan
# pastikan path-nya benar. Nilai yang tertinggal dari deployment lama
# (misalnya masih menunjuk /jelita/perizinan/... yang sudah tidak ada)
# membuat seluruh site_url() mengarah ke URL mati.
# Contoh untuk aplikasi di /var/www/html/ipak_skm:
#   IPAK_BASE_URL=https://domain.contoh/ipak_skm/
IPAK_BASE_URL=

# Database
IPAK_DB_HOST=localhost
IPAK_DB_USER=nama_pengguna_database
IPAK_DB_PASSWORD=ganti_dengan_password_database
IPAK_DB_NAME=backoffice
IPAK_DB_PORT=3306

# Maintenance sinkronisasi database (sync-database.php)
# Endpoint menolak berjalan bila ID atau Password kosong.
IPAK_MAINT_ID=nama_id_maintenance
IPAK_MAINT_PASSWORD=ganti_dengan_password_maintenance

# Daftar IP yang diizinkan, dipisah koma. Kosong berarti semua IP diizinkan.
# Disarankan diisi di production agar endpoint hanya dapat diakses dari
# jaringan internal.
IPAK_MAINT_ALLOWED_IPS=